model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PastaDados", "dim_user", "dim_game", "fact_user_game", "Regras de Co-compra"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_user
ref table dim_game
ref table fact_user_game
ref table 'Regras de Co-compra'

