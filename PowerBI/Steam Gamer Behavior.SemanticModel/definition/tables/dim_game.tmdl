	partition dim_game = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_game.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				        {"game_name", type text}, {"buyers", Int64.Type}, {"players", Int64.Type},
				        {"total_hours", type number}, {"avg_hours_per_player", type number}, {"retention", type number},
				        {"pop_tier", type text}, {"eng_tier", type text}, {"game_segment", type text}
				    }, "en-US"),
				    OrdemPop = Table.AddColumn(Tipos, "pop_order", each if [pop_tier] = "Alta" then 1 else if [pop_tier] = "Média" then 2 else 3, Int64.Type),
				    OrdemEng = Table.AddColumn(OrdemPop, "eng_order", each if [eng_tier] = "Alto" then 1 else if [eng_tier] = "Médio" then 2 else 3, Int64.Type),
				    OrdemSeg = Table.AddColumn(OrdemEng, "segment_order", each [pop_order] * 10 + [eng_order], Int64.Type),
				    Renomeadas = Table.RenameColumns(OrdemSeg, {
				        {"game_name", "Jogo"}, {"pop_tier", "Popularidade"}, {"eng_tier", "Engajamento"}, {"game_segment", "Segmento do Jogo"}
				    })
				in
				    Renomeadas

	annotation PBI_ResultType = Table

