	partition dim_user = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dim_user.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {
				        {"user_id", Int64.Type}, {"n_purchases", Int64.Type}, {"n_played", Int64.Type},
				        {"total_hours", type number}, {"max_hours", type number}, {"avg_hours_played_game", type number},
				        {"play_purchase_ratio", type number}, {"share_top_game_hours", type number},
				        {"segment_rule", type text}, {"cluster_kmeans", type number}
				    }, "en-US"),
				    Cluster = Table.AddColumn(Tipos, "Cluster K-Means", each if [cluster_kmeans] = null then "Sem cluster" else "Cluster " & Text.From(Int64.From([cluster_kmeans])), type text),
				    OrdemCluster = Table.AddColumn(Cluster, "cluster_order", each if [cluster_kmeans] = null then 99 else Int64.From([cluster_kmeans]), Int64.Type),
				    OrdemPersona = Table.AddColumn(OrdemCluster, "persona_order", each
				        if [segment_rule] = "Casual" then 1
				        else if [segment_rule] = "Generalista" then 2
				        else if [segment_rule] = "Especialista" then 3
				        else if [segment_rule] = "Hardcore" then 4
				        else if [segment_rule] = "Colecionador" then 5
				        else 9, Int64.Type),
				    Removidas = Table.RemoveColumns(OrdemPersona, {"cluster_kmeans"}),
				    Renomeadas = Table.RenameColumns(Removidas, {{"user_id", "ID Usuário"}, {"segment_rule", "Persona"}})
				in
				    Renomeadas

	annotation PBI_ResultType = Table

